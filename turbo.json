{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck"] },
    "@vertuo/comply-guards#test": { "dependsOn": ["^typecheck"], "cache": false },
    "dev": { "cache": false, "persistent": true, "env": ["COMPLY_SHELF", "COMPLY_PORT"] }
  }
}
